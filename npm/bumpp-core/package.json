{
  "name": "@vill-v/bumpp-core",
  "version": "5.1.0",
  "license": "MIT",
  "author": {
    "name": "whitekite",
    "email": "1075790909@qq.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vill-v-kit/bumpp",
    "directory": "npm/bumpp-core"
  },
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "napi build --platform --no-js --release",
    "build:debug": "napi build --platform --no-js"
  },
  "napi": {
    "binaryName": "bumpp-core"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "optionalDependencies": {
    "@vill-v/bumpp-core-darwin-arm64": "workspace:*",
    "@vill-v/bumpp-core-linux-arm64-gnu": "workspace:*",
    "@vill-v/bumpp-core-linux-x64-gnu": "workspace:*",
    "@vill-v/bumpp-core-win32-arm64-msvc": "workspace:*",
    "@vill-v/bumpp-core-win32-x64-msvc": "workspace:*"
  },
  "devDependencies": {
    "@napi-rs/cli": "catalog:dev",
    "bumpp": "catalog:",
    "vitest": "catalog:dev"
  }
}
