{
  "name": "@vill-v/bumpp-core",
  "version": "6.1.0",
  "license": "MIT",
  "author": {
    "name": "whitekite",
    "email": "xuxjigsaw@qq.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vill-v-kit/bumpp.git",
    "directory": "napi/bumpp-core"
  },
  "homepage": "https://vill-v-kit.github.io/bumpp/",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "napi build --platform --no-js --release",
    "build:debug": "napi build --platform --no-js"
  },
  "napi": {
    "binaryName": "bumpp-core",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "optionalDependencies": {
    "@vill-v/bumpp-core-darwin-arm64": "workspace:*",
    "@vill-v/bumpp-core-linux-arm64-gnu": "workspace:*",
    "@vill-v/bumpp-core-linux-arm64-musl": "workspace:*",
    "@vill-v/bumpp-core-linux-x64-gnu": "workspace:*",
    "@vill-v/bumpp-core-linux-x64-musl": "workspace:*",
    "@vill-v/bumpp-core-win32-arm64-msvc": "workspace:*",
    "@vill-v/bumpp-core-win32-x64-msvc": "workspace:*"
  },
  "devDependencies": {
    "@napi-rs/cli": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
