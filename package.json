    "@vill-v/prettier-config": "^1.0.0",
    "@vill-v/tsconfig": "^1.0.1",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "taze": "^19.0.2",
    "tsup": "^8.4.0",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
