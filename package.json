{
  "name": "@vill-v/bumpp-monorepo",
  "version": "6.1.0",
  "private": true,
  "repository": "https://github.com/vill-v-kit/bumpp",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check:licenses": "node scripts/check-licenses.mjs",
    "collect:artifacts": "node scripts/collect-artifacts.mjs",
    "create:npm-dirs": "node scripts/create-npm-dirs.mjs",
    "prepare": "hk install",
    "pretest": "turbo run build",
    "release": "vbumpp -r && node scripts/verify-tag-ci.mjs && pnpm build",
    "test": "vitest"
  },
  "devDependencies": {
    "@types/node": "catalog:dev",
    "@vill-v/bumpp-github": "workspace:*",
    "@vill-v/tsconfig": "catalog:dev",
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:dev",
    "publint": "catalog:dev",
    "tsdown": "catalog:dev",
    "turbo": "catalog:dev",
    "typescript": "catalog:dev",
    "unplugin-unused": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "packageManager": "pnpm@11.19.0"
}
