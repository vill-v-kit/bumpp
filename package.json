{
  "name": "@vill-v/bumpp-monorepo",
  "version": "4.0.0",
  "private": true,
  "repository": "https://gitee.com/vill-v/bump",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "release": "vbumpp -r && pnpm build",
    "update:deps": "taze major -w -i -a -r",
    "test": "vitest",
    "clean:deps": "pnpm dlx void-fs del **/node_modules node_modules"
  },
  "devDependencies": {
    "@types/node": "catalog:dev",
    "@types/semver": "catalog:dev",
    "@vill-v/bumpp-gitee": "workspace:*",
    "@vill-v/tsconfig": "catalog:dev",
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:dev",
    "publint": "catalog:dev",
    "taze": "catalog:dev",
    "tsdown": "catalog:dev",
    "turbo": "catalog:dev",
    "typescript": "catalog:dev",
    "unplugin-unused": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "packageManager": "pnpm@10.29.3"
}
