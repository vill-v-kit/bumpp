{
  "name": "@vill-v/bumpp-monorepo",
  "version": "2.2.5",
  "packageManager": "pnpm@10.6.4",
  "private": true,
  "type": "module",
  "repository": "https://gitee.com/vill-v/bump",
  "scripts": {
    "build": "turbo run build",
